{
  "name": "mail-link",
  "version": "0.1.0",
  "description": "Create and process mail-links: URLs referring to individual emails by message-id",
  "keywords": [
    "email",
    "message-id",
    "mail-link"
  ],
  "homepage": "https://github.com/dominique-unruh/mail-link#readme",
  "bugs": {
    "url": "https://github.com/dominique-unruh/mail-link/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominique-unruh/mail-link.git",
    "directory": "mail-link-lib"
  },
  "license": "MIT",
  "author": "Dominique Unruh",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  }
